{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff2|woff|ttf)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/docs/(.*)",
      "dest": "/docs/$1"
    },
    {
      "src": "^/examples/(.*)",
      "dest": "/examples/$1"
    },
    {
      "src": "^/dist/(.*)",
      "dest": "/dist/$1"
    },
    {
      "src": "^/src/(.*)",
      "dest": "/src/$1"
    },
    {
      "src": "^/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "^/cairn-font/(.*)",
      "dest": "/cairn-font/$1"
    },
    {
      "src": "^/playground/?$",
      "dest": "/docs/playground.html"
    },
    {
      "src": "^/examples/?$",
      "dest": "/examples/index.html"
    },
    {
      "src": "^/$",
      "dest": "/docs/index.html"
    }
  ]
}
