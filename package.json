{
  "name": "@eldrex/cairnjs",
  "version": "1.4.0",
  "description": "Zero-dependency, high-performance UI framework with fine-grained reactivity, complete motion suite, declarative form validation, overlays, and WASM acceleration.",
  "type": "module",
  "main": "dist/cairn.js",
  "module": "src/index.js",
  "types": "./cairn.d.ts",
  "bin": {
    "cairn": "./bin/cairn.js",
    "cairnjs": "./bin/cairn.js",
    "create-cairn-app": "./bin/create-cairn-app.js"
  },
  "homepage": "https://cairnjs.vercel.app",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./cairn.d.ts",
      "import": "./src/index.js",
      "require": "./dist/cairn.js"
    },
    "./core": {
      "types": "./cairn.d.ts",
      "import": "./src/core-foundation.js"
    },
    "./dom": {
      "types": "./cairn.d.ts",
      "import": "./src/dom.js"
    },
    "./state": {
      "types": "./cairn.d.ts",
      "import": "./src/state.js"
    },
    "./styling": {
      "types": "./cairn.d.ts",
      "import": "./src/styling.js"
    },
    "./ui": {
      "types": "./cairn.d.ts",
      "import": "./src/ui/index.js"
    },
    "./animation": {
      "types": "./cairn.d.ts",
      "import": "./src/animation.js"
    },
    "./graphics": {
      "types": "./cairn.d.ts",
      "import": "./src/graphics.js"
    },
    "./wasm": {
      "types": "./cairn.d.ts",
      "import": "./src/wasm.js"
    },
    "./green": {
      "types": "./cairn.d.ts",
      "import": "./src/green-code.js"
    },
    "./devtools": {
      "types": "./cairn.d.ts",
      "import": "./src/devtools.js"
    },
    "./scaffolding": {
      "types": "./cairn.d.ts",
      "import": "./src/scaffolding.js"
    },
    "./docs": {
      "types": "./cairn.d.ts",
      "import": "./src/docs.js"
    }
  },
  "files": [
    "src",
    "dist",
    "bin",
    "cairn.d.ts",
    "cairn.schema.json",
    "cairn.types.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cairn.js web",
    "dev": "node bin/cairn.js dev",
    "build": "node build.js",
    "test": "node tests/index.test.js",
    "info": "node bin/cairn.js info",
    "analyze": "node bin/cairn.js analyze"
  },
  "keywords": [
    "cairnjs",
    "cairn",
    "ui-framework",
    "web-components",
    "reactive",
    "signals",
    "state-management",
    "form-validation",
    "data-table",
    "overlays",
    "command-palette",
    "zero-dependencies",
    "wasm",
    "animation",
    "accessibility"
  ],
  "author": "Eldrex Bula & CairnJS Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EldrexDelosReyesBula/CairnJS"
  },
  "publishConfig": {
    "access": "public"
  }
}
